{
  "openapi": "3.1.0",
  "info": {
    "title": "DermaLens AI Research Prototype API",
    "version": "1.0.0",
    "description": "DESIGN CONTRACT ONLY. Not implemented in Phase 0. Research classification, not medical diagnosis."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "tags": [
    {
      "name": "Analyses"
    },
    {
      "name": "Feedback"
    },
    {
      "name": "Copilot"
    },
    {
      "name": "Operations"
    }
  ],
  "paths": {
    "/api/v1/analyses": {
      "post": {
        "tags": [
          "Analyses"
        ],
        "operationId": "createAnalysis",
        "summary": "Evaluate one image with research-only warnings",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 128
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "image": {
                    "type": "string",
                    "format": "binary",
                    "description": "Encoded JPEG/PNG/WebP; size and decode bounds enforced server-side"
                  },
                  "consent_mode": {
                    "type": "string",
                    "enum": [
                      "ephemeral",
                      "history_metadata"
                    ],
                    "default": "ephemeral"
                  }
                },
                "required": [
                  "image",
                  "consent_mode"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "AnalysisResponse",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnalysisResponse"
                }
              }
            }
          },
          "400": {
            "description": "Stable application error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Stable application error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "413": {
            "description": "Stable application error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Stable application error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "Stable application error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Stable application error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": [
          "Analyses"
        ],
        "operationId": "listAnalyses",
        "summary": "List only authenticated owner metadata history",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Owned persisted analyses",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/AnalysisResponse"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Stable application error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Stable application error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/analyses/{analysis_id}": {
      "get": {
        "tags": [
          "Analyses"
        ],
        "operationId": "getAnalysis",
        "parameters": [
          {
            "name": "analysis_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "AnalysisResponse",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnalysisResponse"
                }
              }
            }
          },
          "401": {
            "description": "Stable application error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Stable application error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Analyses"
        ],
        "operationId": "deleteAnalysis",
        "parameters": [
          {
            "name": "analysis_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Owned metadata erased or scheduled for verified erasure"
          },
          "401": {
            "description": "Stable application error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Stable application error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/analyses/{analysis_id}/feedback": {
      "post": {
        "tags": [
          "Feedback"
        ],
        "operationId": "submitFeedback",
        "parameters": [
          {
            "name": "analysis_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FeedbackRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "FeedbackResponse",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FeedbackResponse"
                }
              }
            }
          },
          "400": {
            "description": "Stable application error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Stable application error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Stable application error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Stable application error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/copilot/query": {
      "post": {
        "tags": [
          "Copilot"
        ],
        "operationId": "queryProjectDocs",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CopilotRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "CopilotResponse",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CopilotResponse"
                }
              }
            }
          },
          "401": {
            "description": "Stable application error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Stable application error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "Stable application error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Stable application error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/models/current": {
      "get": {
        "tags": [
          "Operations"
        ],
        "operationId": "currentModel",
        "responses": {
          "200": {
            "description": "ModelStatus",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ModelStatus"
                }
              }
            }
          },
          "401": {
            "description": "Stable application error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/health": {
      "get": {
        "tags": [
          "Operations"
        ],
        "operationId": "liveness",
        "security": [],
        "responses": {
          "200": {
            "description": "HealthStatus",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthStatus"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/readiness": {
      "get": {
        "tags": [
          "Operations"
        ],
        "operationId": "readiness",
        "security": [],
        "responses": {
          "200": {
            "description": "HealthStatus",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthStatus"
                }
              }
            }
          },
          "503": {
            "description": "HealthStatus",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthStatus"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "OIDC JWT"
      }
    },
    "schemas": {
      "Quality": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "accepted": {
            "type": "boolean"
          },
          "score": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 1
          },
          "flags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "accepted",
          "score",
          "flags"
        ]
      },
      "Face": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "count": {
            "type": "integer",
            "minimum": 0
          },
          "detected": {
            "type": "boolean"
          }
        },
        "required": [
          "count",
          "detected"
        ]
      },
      "Prediction": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "category": {
            "type": "string"
          },
          "raw_top_probability": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "Uncalibrated softmax probability, not clinical confidence"
          },
          "probabilities": {
            "type": "object",
            "additionalProperties": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "minProperties": 6,
            "maxProperties": 6
          }
        },
        "required": [
          "category",
          "raw_top_probability",
          "probabilities"
        ]
      },
      "Uncertainty": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "decision": {
            "type": "string",
            "enum": [
              "HIGH_CONFIDENCE_RESULT",
              "LOW_CONFIDENCE_RESULT",
              "OUT_OF_DISTRIBUTION",
              "INSUFFICIENT_IMAGE_QUALITY",
              "UNSUPPORTED_INPUT",
              "HUMAN_REVIEW_RECOMMENDED",
              "POLICY_NOT_VALIDATED"
            ]
          },
          "ood_score": {
            "type": [
              "number",
              "null"
            ]
          },
          "calibration_version": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "decision",
          "ood_score",
          "calibration_version"
        ]
      },
      "XAI": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "available": {
            "type": "boolean"
          },
          "artifact_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "reason": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "available",
          "artifact_id",
          "reason"
        ]
      },
      "ModelTrace": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "model_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "model_version": {
            "type": [
              "string",
              "null"
            ]
          },
          "manifest_sha256": {
            "type": [
              "string",
              "null"
            ]
          },
          "label_map_sha256": {
            "type": [
              "string",
              "null"
            ]
          },
          "preprocessing_version": {
            "type": [
              "string",
              "null"
            ]
          },
          "pipeline_version": {
            "type": "string"
          }
        },
        "required": [
          "model_id",
          "model_version",
          "manifest_sha256",
          "label_map_sha256",
          "preprocessing_version",
          "pipeline_version"
        ]
      },
      "AnalysisResponse": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "analysis_id": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string",
            "enum": [
              "completed",
              "abstained",
              "rejected",
              "failed"
            ]
          },
          "reason_code": {
            "type": [
              "string",
              "null"
            ]
          },
          "input_quality": {
            "$ref": "#/components/schemas/Quality"
          },
          "face": {
            "$ref": "#/components/schemas/Face"
          },
          "prediction": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/Prediction"
              },
              {
                "type": "null"
              }
            ]
          },
          "uncertainty": {
            "$ref": "#/components/schemas/Uncertainty"
          },
          "explainability": {
            "$ref": "#/components/schemas/XAI"
          },
          "model": {
            "$ref": "#/components/schemas/ModelTrace"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "disclaimer": {
            "type": "string"
          },
          "persisted": {
            "type": "boolean"
          }
        },
        "required": [
          "analysis_id",
          "status",
          "reason_code",
          "input_quality",
          "face",
          "prediction",
          "uncertainty",
          "explainability",
          "model",
          "created_at",
          "disclaimer",
          "persisted"
        ]
      },
      "FeedbackRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "rating": {
            "type": "string",
            "enum": [
              "correct",
              "incorrect",
              "unsure"
            ]
          },
          "proposed_category": {
            "type": [
              "string",
              "null"
            ]
          },
          "note": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 1000
          }
        },
        "required": [
          "rating"
        ]
      },
      "FeedbackResponse": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "feedback_id": {
            "type": "string",
            "format": "uuid"
          },
          "review_status": {
            "type": "string",
            "enum": [
              "submitted",
              "under_review",
              "validated",
              "rejected"
            ]
          }
        },
        "required": [
          "feedback_id",
          "review_status"
        ]
      },
      "CopilotRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "question": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1200
          }
        },
        "required": [
          "question"
        ]
      },
      "Source": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "document": {
            "type": "string"
          },
          "heading": {
            "type": "string"
          },
          "chunk_id": {
            "type": "string"
          },
          "version": {
            "type": "string"
          }
        },
        "required": [
          "document",
          "heading",
          "chunk_id",
          "version"
        ]
      },
      "CopilotResponse": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "answer": {
            "type": "string"
          },
          "grounded": {
            "type": "boolean"
          },
          "sources": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Source"
            }
          },
          "status": {
            "type": "string",
            "enum": [
              "answered",
              "unsupported_question",
              "refused"
            ]
          }
        },
        "required": [
          "answer",
          "grounded",
          "sources",
          "status"
        ]
      },
      "ModelStatus": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "ready": {
            "type": "boolean"
          },
          "model_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "model_version": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "ready",
          "model_id",
          "model_version"
        ]
      },
      "HealthStatus": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "not_ready"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "ErrorResponse": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "error": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "code",
              "message"
            ]
          },
          "request_id": {
            "type": "string"
          }
        },
        "required": [
          "error",
          "request_id"
        ]
      }
    }
  }
}
