# Future public frontend configuration; NEVER put API keys or medical data here.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# Optional public OIDC authorization-code/PKCE client for protected research history.
# Requires external OIDC identity provider, CORS-enabled token endpoint and RS256
# access tokens accepted by the backend issuer/audience. NO CLIENT SECRET IN BROWSER.
# NEXT_PUBLIC_OIDC_AUTHORIZATION_URL=https://issuer.example/authorize
# NEXT_PUBLIC_OIDC_TOKEN_URL=https://issuer.example/oauth/token
# NEXT_PUBLIC_OIDC_CLIENT_ID=public-client-id
# NEXT_PUBLIC_OIDC_AUDIENCE=dermalens-api
