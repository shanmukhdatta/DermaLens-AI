# Public API used only for anonymous image quality checks.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# Optional: verified OpenID Connect browser login / owner-scoped history.
# Set ALL values together; never commit live credentials.
# API must separately configure matching DERMALENS_OIDC_ISSUER,
# DERMALENS_OIDC_AUDIENCE and DERMALENS_OIDC_JWKS_URL.
# Register EXACT redirect URI: http://localhost:3000/api/auth/callback
# OIDC provider must issue an RS256 JWT access token for the backend API audience.
# DERMALENS_WEB_APP_ORIGIN=http://localhost:3000
# DERMALENS_WEB_API_BASE_URL=http://127.0.0.1:8000
# DERMALENS_WEB_OIDC_ISSUER=https://issuer.example/
# DERMALENS_WEB_OIDC_CLIENT_ID=
# DERMALENS_WEB_OIDC_CLIENT_SECRET=
# DERMALENS_WEB_SESSION_KEY= # 32 random bytes encoded as 64 hex characters
