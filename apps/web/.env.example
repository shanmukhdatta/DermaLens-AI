# Web app: Vercel project root must be apps/web
# Server-side API hostname; set only when a reachable HTTPS FastAPI service exists.
# Leaving this unset on Vercel publishes the informational site, while quality
# checks and document search return an honest 503 (never a fake analysis).
# DERMALENS_WEB_API_BASE_URL=https://your-fastapi-host.example

# Optional real OIDC sign-in for protected research accounts.
# Use exact HTTPS callback URL https://your-web-domain/api/auth/callback.
# Set all OIDC variables together; API OIDC issuer/audience/JWKS must agree.
# DERMALENS_WEB_APP_ORIGIN=https://your-web-domain
# DERMALENS_WEB_OIDC_ISSUER=https://your-provider.example/
# DERMALENS_WEB_OIDC_CLIENT_ID=
# DERMALENS_WEB_OIDC_CLIENT_SECRET=
# DERMALENS_WEB_SESSION_KEY= # 64 hex characters / 32 random bytes

# No NEXT_PUBLIC API token, model path, secret or facial data.
