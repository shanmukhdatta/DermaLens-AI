# TEMPLATE ONLY - never commit real secrets. Backend Phase 2+.
DERMALENS_ENV=development
DERMALENS_API_HOST=127.0.0.1
DERMALENS_API_PORT=8000
DERMALENS_PUBLIC_WEB_ORIGIN=http://localhost:3000

# Local dev only; provision role-scoped credentials before Phases 3 and 8.
DATABASE_URL=postgresql+psycopg://dermalens:change-me-locally@localhost:5432/dermalens
# Do NOT populate with real secrets in Git. Phase 7 only.
GROK_API_KEY=
GROK_MODEL=
# Phase 9 artifact reference; must be integrity verified.
MODEL_MANIFEST_PATH=
# Optional separate-consent image retention unavailable until privacy review.
ENABLE_IMAGE_STORAGE=false
ENABLE_RESEARCH_IMAGE_OPT_IN=false

# Phase 3: optional persistence and cryptographically validated OIDC.
# Do not commit real credentials. Run Alembic migrations before account APIs.
# DERMALENS_DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/dermalens
# DERMALENS_OIDC_ISSUER=https://your-issuer.example/
# DERMALENS_OIDC_AUDIENCE=dermalens-api
# DERMALENS_OIDC_JWKS_URL=https://your-issuer.example/.well-known/jwks.json
